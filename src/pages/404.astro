---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sitePath } from "../utils/paths";
---

<BaseLayout
  title="页面未找到"
  description="这个地址不存在，或者内容已经移动。"
>
  <section class="notfound wrap">
    <p class="notfound__code" aria-hidden="true">404</p>
    <p class="notfound__mark" aria-hidden="true">無</p>

    <h1 class="notfound__title">这里没有内容</h1>
    <p class="lede notfound__lede">
      这个地址不存在，或者内容已经移动到其他位置。
    </p>

    <p class="notfound__actions label">
      <a href={sitePath()}>返回首页</a>
      <span aria-hidden="true">·</span>
      <a href={sitePath("/blog/")}>全部文章</a>
    </p>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 60svh;
    padding-block: var(--space-24);
    text-align: center;
  }

  .notfound__code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
  }

  .notfound__mark {
    margin-top: var(--space-6);
    font-size: 9rem;
    line-height: 1;
    color: var(--color-fg-faint);
  }

  .notfound__title {
    margin-top: var(--space-8);
    font-size: var(--text-xl);
  }

  .notfound__lede {
    max-width: 32rem;
    margin-top: var(--space-4);
  }

  .notfound__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }

  .notfound__actions a {
    text-decoration: none;
  }

  .notfound__actions a:hover {
    color: var(--color-accent);
  }

  @media (max-width: 40rem) {
    .notfound__mark {
      font-size: 5rem;
    }
  }
</style>
