---
import PageHeader from "../../components/PageHeader.astro";
import PostCard from "../../components/PostCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BLOG } from "../../config";
import { sitePath } from "../../utils/paths";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const visiblePosts = posts.slice(0, BLOG.postsPerPage);
const lastPage = Math.ceil(posts.length / BLOG.postsPerPage);
---

<BaseLayout title="技术博客" description="按时间整理的历史技术文章与实践记录。">
  <div class="wrap">
    <PageHeader
      eyebrow="Writing"
      title="技术博客"
      lede="关于软件开发、系统实践、物联网与产品工作的长期记录。"
    />

    <div class="post-list">
      {visiblePosts.map((post) => <PostCard post={post} />)}
    </div>

    {
      lastPage > 1 && (
        <nav class="archive-nav label" aria-label="博客分页">
          <span>01 / {String(lastPage).padStart(2, "0")}</span>
          <a href={sitePath("/blog/page/2/")}>更早文章 →</a>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .archive-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .archive-nav a {
    text-decoration: none;
  }
</style>
