---
import type { GetStaticPaths } from "astro";

import PageHeader from "../../../components/PageHeader.astro";
import PostCard from "../../../components/PostCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BLOG } from "../../../config";
import { sitePath } from "../../../utils/paths";
import { getPublishedPosts, type Post } from "../../../utils/posts";

interface Props {
  posts: Post[];
  currentPage: number;
  lastPage: number;
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const lastPage = Math.ceil(posts.length / BLOG.postsPerPage);

  return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
    const currentPage = index + 2;
    const start = (currentPage - 1) * BLOG.postsPerPage;
    return {
      params: { page: String(currentPage) },
      props: {
        posts: posts.slice(start, start + BLOG.postsPerPage),
        currentPage,
        lastPage,
      },
    };
  });
}) satisfies GetStaticPaths;

const { posts, currentPage, lastPage } = Astro.props;
const previousHref =
  currentPage === 2 ? sitePath("/blog/") : sitePath(`/blog/page/${currentPage - 1}/`);
const nextHref =
  currentPage < lastPage ? sitePath(`/blog/page/${currentPage + 1}/`) : undefined;
---

<BaseLayout
  title={`技术博客 · 第 ${currentPage} 页`}
  description="按时间整理的历史技术文章与实践记录。"
>
  <div class="wrap">
    <PageHeader eyebrow="Writing" title="技术博客" lede={`第 ${currentPage} 页`} />

    <div class="post-list">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <nav class="archive-nav label" aria-label="博客分页">
      <a href={previousHref} rel="prev">← 较新文章</a>
      <span>{String(currentPage).padStart(2, "0")} / {String(lastPage).padStart(2, "0")}</span>
      {nextHref ? <a href={nextHref} rel="next">更早文章 →</a> : <span />}
    </nav>
  </div>
</BaseLayout>

<style>
  .post-list {
    margin-top: var(--space-4);
  }

  .post-list :global(.post-card:last-child) {
    border-bottom: none;
  }

  .archive-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-4);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--rule-width) solid var(--color-rule);
  }

  .archive-nav a {
    text-decoration: none;
  }

  .archive-nav a:last-child {
    text-align: right;
  }
</style>
