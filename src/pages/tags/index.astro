---
import PageHeader from "../../components/PageHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../utils/paths";
import { collectTags, getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const tags = collectTags(posts);

const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout
  title="标签"
  description="按技术主题浏览博客文章。"
>
  <div class="wrap">
    <PageHeader
      eyebrow="Index"
      title="文章标签"
      lede={`${posts.length} 篇文章，共 ${tags.length} 个主题。`}
    />

    {
      tags.length > 0 ? (
        <ul class="tag-grid rule-grid">
          {tags.map((tag, index) => (
            <li>
              <a class="tag-cell" href={sitePath(`/tags/${tag.slug}/`)}>
                <span class="tag-cell__no label">{pad(index + 1)}</span>
                <span class="tag-cell__name">{tag.name}</span>
                <span class="tag-cell__count label">
                  {tag.count} 篇文章
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="tag-grid__empty lede">暂时还没有标签。</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .tag-grid {
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    margin-top: var(--space-12);
    padding: 0;
    list-style: none;
  }

  .tag-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 9rem;
    padding: var(--space-6);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out);
  }

  .tag-cell:hover {
    background: var(--color-bg-subtle);
    color: inherit;
  }

  .tag-cell__name {
    margin-top: auto;
    font-size: var(--text-lg);
  }

  .tag-cell:hover .tag-cell__name {
    color: var(--color-accent);
  }

  .tag-grid__empty {
    margin-top: var(--space-12);
  }
</style>
