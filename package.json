{
  "name": "leroi-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A searchable documentation and FAQ site for Leroi / Liu Lichen.",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy": "pnpm run docs:build && wrangler deploy",
    "preview": "pnpm run docs:build && wrangler dev"
  },
  "keywords": [
    "docs",
    "faq",
    "vitepress",
    "github-pages"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "vitepress": "^1.6.4",
    "wrangler": "^4.95.0"
  }
}
