{
  "name": "leroi-hexo-stellar-blog",
  "version": "0.1.0",
  "private": true,
  "description": "Leroi's technical blog built with Hexo and the Stellar theme.",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "scripts": {
    "clean": "hexo clean",
    "dev": "hexo server",
    "check": "node tools/validate-content.mjs",
    "build": "pnpm run check && hexo generate && node tools/validate-output.mjs",
    "import:blog": "node tools/import-legacy-blog.mjs"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-front-matter": "4.2.1",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-stellar": "2.0.0-rc.1"
  }
}
